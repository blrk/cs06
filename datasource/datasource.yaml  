# datasource.yaml
apiVersion: 1

datasources:
  - name: Elasticsearch-Logs
    type: elasticsearch
    access: proxy
    url: http://elasticsearch:9200  # IMPORTANT: Use the Docker service name, not localhost
    database: log-anomalies
    basicAuth: false
    isDefault: true
    version: 1 # Legacy parameter, set to 1 for new formats
    jsonData:
      esVersion: 800 # For Elasticsearch 8.x
      timeField: timestamp # Crucial for time-series graphs! Make sure your Spark output includes this field.
      maxConcurrentShardRequests: 5
    readOnly: false